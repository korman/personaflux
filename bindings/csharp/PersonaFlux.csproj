    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>PersonaFlux</AssemblyName>
    <RootNamespace>PersonaFlux</RootNamespace>
    <PackageId>PersonaFlux</PackageId>
